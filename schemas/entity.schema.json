{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-catalog-processes/schemas/entity.schema.json",
  "title": "Process Catalog Entry",
  "description": "Schema for entries in technehub-labs/dea-catalog-processes. Mirrors technehub-labs/dea-metamodel/schemas/entities/process.json (v3.0.0-alpha).",
  "type": "object",
  "required": ["id", "name", "type", "version", "process_intent", "process_audience"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$" },
    "type": { "type": "string", "const": "Process" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "process_intent": {
      "type": "string",
      "enum": ["operational", "support", "management"]
    },
    "process_audience": {
      "type": "string",
      "enum": [
        "governance-existence", "supply-resources", "people-organization",
        "customer-demand", "product-offering", "operations-delivery", "finance-value"
      ]
    },
    "owner": { "type": "string" },
    "trigger": { "type": "string", "maxLength": 500 },
    "outcome": { "type": "string", "maxLength": 500 },
    "parent_process": { "type": "string" },
    "child_processes": { "type": "array", "items": { "type": "string" } },
    "capabilities_delivered": { "type": "array", "items": { "type": "string" } },
    "services_provided": { "type": "array", "items": { "type": "string" } },
    "components_involved": { "type": "array", "items": { "type": "string" } },
    "kpis": { "type": "array", "items": { "type": "string" } },
    "stakeholders": { "type": "array", "items": { "type": "string" } },
    "actors": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" },
    "ecfConformance": {
      "type": "object",
      "description": "ECF Conformance Gate manifest (CR-ECF-CG-001..004). Declares the catalog's CONFORMANT-WITH-EXTENSION status and the canonical ECF references that resolve. Optional at schema level; scripts/check_ecf_conformance.py enforces presence on every canonical process entry. Note: process_audience is NOT an ECF Coordinate; it is a single-axis audience classification (CG-004 §10). The canonical ECF reference (when present) lives in this ecfConformance block.",
      "properties": {
        "framework": { "type": "string", "const": "EnterpriseConceptFramework" },
        "contractVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "profile": { "type": "string", "pattern": "^dea:ecf@\\d+\\.\\d+\\.\\d+$" },
        "status": { "type": "string", "enum": ["conformant", "conformant-with-extension", "non-conformant", "not-yet-assessed"] },
        "affiliation": { "type": "string", "enum": ["mapped", "held-unmapped", "inherits-catalog"] },
        "rationaleRef": { "type": "string" },
        "canonicalReferences": { "type": "array" },
        "extensions": { "type": "array" }
      }
    }
  }
}
